import { Glyph, Icon } from "../icons.slint";
import { IconButton } from "../primitives/panel.slint";
import { Select } from "../primitives/select.slint";
import { LevelMeter } from "../primitives/level-meter.slint";
import { Button, Field } from "../primitives/modal.slint";
import { ResizeBox } from "../primitives/resize-box.slint";
import { ThinScrollbar } from "../primitives/scrollbar.slint";
import { Tip, Tips } from "../primitives/tooltip.slint";
import { PauseCutData, TimelineNoteData } from "../timeline/model.slint";
import { Pane, PaneHeader } from "pane.slint";
import { ProjectBriefEditor } from "project-brief.slint";
