export struct AgentMessageData {
    id: string,
    role: string,
    text: string,
    streaming: bool,
    failed: bool,
    context: string,
    edit-links: [string],
    has-checkpoint: bool,
}

export struct AgentApprovalData {
    id: string,
    title: string,
    detail: string,
}

export struct AgentSavedChatData {
    id: string,
    title: string,
    workspace: string,
    active: bool,
    has-draft: bool,
}

export struct AgentQuickActionData {
    id: string,
    label: string,
    pinned: bool,
}

export struct AgentParameterData {
    name: string,
    value: string,
}

export struct AgentEditTrackData {
    id: string,
    label: string,
    selected: bool,
}

export struct AgentQueueItem {
    id: string,
    prompt: string,
    status: string,
    detail: string,
    pending: bool,
    can-move-up: bool,
    can-move-down: bool,
    cancelled: bool,
    recoverable: bool,
    drag-token: string,
}

export global Agent {
    in property <bool> enabled;
    in property <bool> connected;
    in property <[AgentSavedChatData]> saved-chats;
    in property <bool> history-open;
    in property <bool> history-loading;
    in property <string> history-error;
    in-out property <string> chat-query;
    in property <bool> chat-opening;
    in property <string> chat-title;
    in property <bool> has-earlier;
    in property <bool> earlier-loading;
    callback toggle-history();
    callback chat-filter-edited(query: string);
    callback open-chat(id: string);
    callback load-earlier();
    in property <bool> queue-open;
    in property <bool> queue-paused;
    in property <bool> queue-can-enqueue;
    in property <bool> queue-can-run;
    in property <int> queue-count;
    in property <[AgentQueueItem]> queue-items;
    in property <string> queue-error;
    callback toggle-queue();
    callback enqueue-draft();
    callback queue-set-paused(paused: bool);
    callback queue-move(id: string, offset: int);
    callback queue-can-drop(source: string, target: string) -> bool;
    callback queue-drop(source: string, target: string, after: bool) -> bool;
    callback queue-cancel(id: string);
    callback queue-restore-cancelled(id: string);
    callback queue-restore(id: string);
    in property <[AgentMessageData]> messages;
    in property <[AgentApprovalData]> approvals;
    in-out property <string> draft;
    in property <bool> busy;
    in property <bool> maintenance;
    in property <string> status: I18n.t("chatUi.emptyPrompt");
    in property <string> error;
    in property <string> project-name;
    in property <bool> has-project;
    in property <string> workspace-path;
    in property <[string]> model-options;
    in property <[string]> effort-options;
    in-out property <int> model-index: -1;
    in-out property <int> effort-index: -1;
    in property <string> model-placeholder: I18n.t("chatUi.connect");
    in property <string> effort-placeholder: I18n.t("chatUi.defaultEffort");
    callback model-selected(index: int);
    callback effort-selected(index: int);
    in property <bool> dictation-available;
    /// 0 idle, 1 preparing, 2 recording, 3 finishing.
    in property <int> dictation-phase;
    in property <string> dictation-status;
    in property <string> dictation-preview;
    in property <string> dictation-error;
    in property <float> dictation-level;
    in property <int> dictation-seconds;
    in-out property <string> dictation-language: "ru-RU";
    callback dictation-start();
    callback dictation-stop();
    callback dictation-cancel();
    callback choose-workspace();
    in property <[string]> attachments;
    callback choose-files();
    callback remove-file(index: int);
    pure callback can-drop-payload(data: data-transfer) -> bool;
    callback drop-payload(data: data-transfer, x: length, y: length) -> bool;
    in property <string> timeline-label;
    in-out property <bool> include-timeline: true;
    in property <bool> has-range;
    in property <bool> edit-scope-open;
    in property <bool> edit-scope-active;
    in property <bool> edit-scope-can-save;
    in property <bool> edit-scope-limit-range;
    in property <bool> edit-scope-range-ready;
    in property <[AgentEditTrackData]> edit-scope-tracks;
    in property <string> edit-scope-summary;
    in property <string> edit-scope-range-label;
    in property <string> edit-scope-error;
    callback toggle-edit-scope();
    callback edit-scope-track(id: string, included: bool);
    callback toggle-edit-scope-range(enabled: bool);
    callback save-edit-scope();
    callback clear-edit-scope();
    in property <[AgentQuickActionData]> quick-actions;
    in property <bool> quick-ready;
    callback run-quick-action(id: string);
    in property <bool> cutaway-ready;
    callback suggest-cutaways();
    callback pin-quick-action();
    callback pin-template();
    in property <[AgentParameterData]> parameter-fields;
    in property <string> parameter-title;
    in property <string> parameter-scope;
    in property <string> parameter-error;
    in property <bool> parameter-can-send;
    callback parameter-edited(index: int, value: string);
    callback submit-parameters();
    callback cancel-parameters();
    in property <bool> brief-open;
    in property <bool> brief-can-save;
    in property <string> brief-error;
    in-out property <string> brief-goal;
    in-out property <string> brief-audience;
    in-out property <string> brief-style;
    callback toggle-brief();
    callback save-brief();
    callback unpin-quick-action(id: string);
    in property <[PauseCutData]> pause-cuts;
    in property <int> pause-selected-count;
    in property <int> pause-audition: -1;
    in property <bool> pause-can-apply;
    callback set-pause-included(id: int, included: bool);
    callback jump-to-pause(id: int);
    callback audition-pause(id: int);
    callback apply-pause-cuts();
    callback discard-pause-cuts();
    in property <[TimelineNoteData]> notes;
    in property <bool> notes-open;
    in property <string> note-target;
    in property <string> notes-error;
    in property <bool> notes-can-send;
    in-out property <string> note-draft;
    in property <int> note-focus;
    in-out property <int> note-edit-id;
    in-out property <string> note-edit-draft;
    callback toggle-notes();
    callback add-note(text: string) -> bool;
    callback edit-note(id: int, text: string) -> bool;
    callback select-note(id: int, selected: bool);
    callback jump-to-note(id: int);
    callback review-note(id: int, accepted: bool);
    callback remove-note(id: int);
    callback send-notes();
    in property <string> undoable-message;
    callback mark-range(start: bool);
    callback clear-range();
    callback jump-to-edit(id: string, index: int);
    callback restore-turn(id: string, copy: bool);
    in-out property <length> drop-left;
    in-out property <length> drop-top;
    in-out property <length> drop-width;
    in-out property <length> drop-height;
    callback draft-edited(text: string);
    callback submitted();
    callback interrupt();
    callback new-thread();
    callback reconnect();
    callback approval(id: string, accepted: bool);
}

component AgentTextMenu inherits ContextMenuArea {
    in property <bool> has-selection;
    in property <bool> has-text;
    in property <bool> editable;
    callback copy-text();
    callback paste-text();
    callback select-text();

    Menu {
        MenuItem {
            title: I18n.t("common.copy");
            enabled: root.has-selection;
            activated => { root.copy-text(); }
        }
        if root.editable: MenuItem {
            title: I18n.t("studio.paste");
            activated => { root.paste-text(); }
        }
        MenuItem {
            title: I18n.t("shortcuts.selectAll");
            enabled: root.has-text;
            activated => { root.select-text(); }
        }
    }
}

component AgentWords inherits TextInput {
    min-width: 0px;
    color: Theme.fg;
    font-size: Theme.fs-lg;
    read-only: true;
    single-line: false;
    wrap: word-wrap;
    selection-background-color: Theme.accent;
    selection-foreground-color: Theme.on-accent;

    AgentTextMenu {
        width: parent.width;
        height: parent.height;
        has-selection: root.anchor-position-byte-offset != root.cursor-position-byte-offset;
        has-text: root.text != "";
        copy-text => { root.copy(); }
        select-text => { root.focus(); root.select-all(); }
    }
}

// Bound transient speech and errors so the composer stays inside the pane.
component AgentTextViewport inherits Flickable {
    in property <string> value;
    in property <brush> ink: Theme.fg;
    in property <bool> follow-end;
    min-width: 0px;
    min-height: 0px;
    max-height: 72px;
    preferred-height: Math.min(72px, words.preferred-height);
    vertical-stretch: 0;
    interactive: false;
    content-width: self.width;
    content-height: Math.max(self.height, words.preferred-height);
    changed content-height => {
        if (root.follow-end) {
            self.content-y = Math.min(0px, self.height - self.content-height);
        }
    }
    words := AgentWords {
        width: root.width;
        height: self.preferred-height;
        text: root.value;
        color: root.ink;
        font-size: Theme.fs;
        wrap: word-wrap;
    }
    ThinScrollbar {
        x: parent.width - self.width - 1px;
        y: -root.content-y;
        height: root.height;
        viewport: root.height;
        content: root.content-height;
        offset: -root.content-y;
        scrolled(to) => { root.content-y = -to; }
    }
}

export component ChatAction inherits Rectangle {
    in property <string> label;
    in property <string> accessible-name: root.label;
    in property <string> tip: root.square ? root.label : "";
    in property <bool> enabled: true;
    in property <bool> ghost: true;
    in property <bool> primary;
    in property <bool> elide-label;
    in property <Glyph> glyph: Glyph.none;
    in property <bool> square;
    out property <bool> focused: keys.has-focus;
    callback clicked();
    min-width: action.min-width;
    min-height: action.min-height;
    max-height: action.max-height;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-description: root.tip != root.accessible-name ? root.tip : "";
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled { root.clicked(); }
    }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    action := Button {
        width: parent.width;
        height: parent.height;
        label: root.elide-label ? "" : root.label;
        enabled: root.enabled;
        ghost: root.ghost;
        primary: root.primary;
        glyph: root.glyph;
        square: root.square;
        tip: root.tip;
        border-width: keys.has-focus ? 1px : 0px;
        border-color: Theme.accent;
        clicked => { root.clicked(); }
    }
    if root.elide-label: Text {
        x: 8px;
        width: Math.max(0px, root.width - 16px);
        height: root.height;
        text: root.label;
        overflow: elide;
        vertical-alignment: center;
        color: Theme.fg;
        opacity: root.enabled ? 1.0 : 0.45;
        font-size: Theme.fs;
        font-weight: Theme.weight-title;
    }
}

component NoteInput inherits Rectangle {
    in-out property <string> value;
    in property <string> label;
    in property <bool> enabled: true;
    in property <int> focus-request;
    callback submitted();
    callback edited(text: string);

    init => { if root.focus-request > 0 { input.focus(); } }
    changed focus-request => { if root.focus-request > 0 { input.focus(); } }

    min-width: 0px;
    min-height: frame.min-box;
    max-height: frame.max-box;
    preferred-height: Math.clamp(frame.box-height, frame.min-box, frame.max-box);
    vertical-stretch: 0;

    frame := ResizeBox {
        width: parent.width;
        height: parent.height;
        min-box: 44px;
        max-box: 120px;
        box-height: 64px;
        focused: input.has-focus;
        content-height: input.preferred-height;

        input := TextInput {
            y: frame.pad-y;
            width: Math.max(0px, frame.width - 2 * frame.pad-x);
            height: Math.max(self.preferred-height, frame.view-height);
            text <=> root.value;
            accessible-label: root.label;
            edited => { root.edited(self.text); }
            enabled: root.enabled;
            color: Theme.fg;
            font-size: Theme.fs-lg;
            single-line: false;
            wrap: word-wrap;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-accent;
            cursor-position-changed(at) => { frame.reveal(at.y, self.font-size * 1.4); }
            key-pressed(event) => {
                if (event.text == Key.Return && (event.modifiers.control || event.modifiers.meta)) {
                    root.submitted();
                    return accept;
                }
                return reject;
            }
        }
        if root.value == "" && !input.has-focus: Text {
            y: frame.pad-y;
            text: root.label;
            color: Theme.fg-dim;
            font-size: Theme.fs-lg;
        }
    }
}

component TimelineNoteRow inherits Rectangle {
    in property <TimelineNoteData> note;
    in property <bool> can-edit;
    property <bool> may-change: root.can-edit && !root.note.working;
    min-height: body.preferred-height;
    min-width: 0px;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: root.note.selected ? Theme.accent : Theme.line;
    background: Theme.field;

    body := VerticalLayout {
        padding: 7px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 4px;
            if root.note.status == 0: ChatAction {
                label: (root.note.selected ? I18n.t1("chatUi.deselectNote", "" + root.note.id) : I18n.t1("chatUi.selectNote", "" + root.note.id));
                glyph: root.note.selected ? Glyph.check : Glyph.none;
                square: true;
                ghost: false;
                enabled: root.may-change;
                clicked => { Agent.select-note(root.note.id, !root.note.selected); }
            }
            ChatAction {
                label: root.note.label;
                accessible-name: I18n.t1("chatUi.goNote", "" + root.note.id);
                min-width: 0px;
                horizontal-stretch: 1;
                elide-label: true;
                enabled: !Agent.maintenance;
                clicked => { Agent.jump-to-note(root.note.id); }
            }
            Text {
                text: root.note.working ? I18n.t("chatUi.noteWorking")
                    : root.note.status == 1 ? I18n.t("chatUi.noteReview")
                    : root.note.status == 2 ? I18n.t("chatUi.noteDone") : I18n.t("chatUi.noteOpen");
                color: root.note.working ? Theme.accent
                    : root.note.status == 1 ? Theme.warn
                    : root.note.status == 2 ? Theme.green : Theme.fg-muted;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }
        }
        Text {
            min-width: 0px;
            text: root.note.text;
            color: Theme.fg;
            font-size: Theme.fs;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 3px;
            ChatAction {
                label: I18n.t("chatUi.editNote");
                tip: I18n.t("chatUi.editNoteTip");
                accessible-name: I18n.t1("chatUi.editNoteNumber", "" + root.note.id);
                enabled: root.may-change && Agent.note-edit-id == 0;
                clicked => {
                    Agent.note-edit-id = root.note.id;
                    Agent.note-edit-draft = root.note.text;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.note.status == 1: ChatAction {
                label: I18n.t("chatUi.approveNote");
                tip: I18n.t("chatUi.approveNoteTip");
                accessible-name: I18n.t1("chatUi.approveNoteNumber", "" + root.note.id);
                enabled: root.may-change;
                clicked => { Agent.review-note(root.note.id, true); }
            }
            if root.note.status > 0: ChatAction {
                label: I18n.t("chatUi.reopenNote");
                tip: I18n.t("chatUi.reopenNoteTip");
                accessible-name: I18n.t1("chatUi.reopenNoteNumber", "" + root.note.id);
                enabled: root.may-change;
                clicked => { Agent.review-note(root.note.id, false); }
            }
            ChatAction {
                label: I18n.t1("chatUi.removeNote", "" + root.note.id);
                tip: I18n.t("chatUi.removeNoteTip");
                glyph: Glyph.trash;
                square: true;
                enabled: root.may-change;
                clicked => {
                    let id = root.note.id;
                    Agent.remove-note(id);
                    if (Agent.notes-error == "" && Agent.note-edit-id == id) {
                        Agent.note-edit-id = 0;
                        Agent.note-edit-draft = "";
                    }
                }
            }
        }
    }
}

component TimelineNotesView inherits VerticalLayout {
    property <bool> can-edit: Agent.enabled && Agent.has-project && !Agent.maintenance;
    min-width: 0px;
    min-height: 0px;
    preferred-height: 0px;
    vertical-stretch: 1;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 10px;
    spacing: 8px;

    function add() {
        if (root.can-edit && Agent.note-draft != "" && Agent.add-note(Agent.note-draft)) {
            Agent.note-draft = "";
        }
    }
    function save() {
        if (root.can-edit && Agent.note-edit-draft != ""
            && Agent.edit-note(Agent.note-edit-id, Agent.note-edit-draft)) {
            root.cancel-edit();
        }
    }
    function cancel-edit() {
        Agent.note-edit-id = 0;
        Agent.note-edit-draft = "";
    }

    if Agent.notes-error != "": AgentTextViewport {
        value: Agent.notes-error;
        ink: Theme.danger;
    }

    viewport := Flickable {
        min-width: 0px;
        min-height: 0px;
        preferred-height: 0px;
        vertical-stretch: 1;
        content-width: self.width;
        content-height: Math.max(self.height, items.preferred-height);

        items := VerticalLayout {
            width: Math.max(0px, viewport.width - 8px);
            spacing: 5px;
            alignment: start;
            if Agent.notes.length == 0: Text {
                text: I18n.t("chatUi.notesEmpty");
                color: Theme.fg-muted;
                font-size: Theme.fs;
                wrap: word-wrap;
            }
            for note in Agent.notes: TimelineNoteRow {
                note: note;
                can-edit: root.can-edit;
            }
        }
        ThinScrollbar {
            x: parent.width - self.width;
            y: -viewport.content-y;
            height: viewport.height;
            viewport: viewport.height;
            content: viewport.content-height;
            offset: -viewport.content-y;
            scrolled(to) => { viewport.content-y = -to; }
        }
    }

    if Agent.note-edit-id > 0: VerticalLayout {
        spacing: 5px;
        Text {
            text: I18n.t1("chatUi.editNoteNumber", "" + Agent.note-edit-id);
            color: Theme.fg-muted;
            font-size: Theme.fs;
        }
        NoteInput {
            value <=> Agent.note-edit-draft;
            label: I18n.t("chatUi.noteEditText");
            focus-request: Agent.note-focus;
            enabled: root.can-edit;
            submitted => { root.save(); }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 5px;
            ChatAction {
                label: I18n.t("chatUi.cancelEdit");
                tip: I18n.t("chatUi.cancelEditTip");
                clicked => { root.cancel-edit(); }
            }
            ChatAction {
                label: I18n.t("chatUi.saveNote");
                tip: I18n.t("chatUi.saveNoteTip");
                primary: true;
                enabled: root.can-edit && Agent.note-edit-draft != "";
                clicked => { root.save(); }
            }
        }
    }
    if Agent.note-edit-id == 0: VerticalLayout {
        spacing: 5px;
        Text {
            text: Agent.note-target;
            min-width: 0px;
            overflow: elide;
            color: Theme.fg-muted;
            font-size: Theme.fs;
        }
        HorizontalLayout {
            spacing: 4px;
            ChatAction {
                label: I18n.t("chatUi.setIn");
                tip: I18n.t("chatUi.setInTip");
                enabled: root.can-edit;
                clicked => { Agent.mark-range(true); }
            }
            ChatAction {
                label: I18n.t("chatUi.setOut");
                tip: I18n.t("chatUi.setOutTip");
                enabled: root.can-edit && Agent.has-range;
                clicked => { Agent.mark-range(false); }
            }
            if Agent.has-range: ChatAction {
                label: I18n.t("chatUi.clearRange");
                tip: I18n.t("chatUi.clearRangeTip");
                enabled: root.can-edit;
                clicked => { Agent.clear-range(); }
            }
        }
        NoteInput {
            value <=> Agent.note-draft;
            label: I18n.t("chatUi.noteText");
            focus-request: Agent.note-focus;
            enabled: root.can-edit;
            submitted => { root.add(); }
        }
        HorizontalLayout {
            spacing: 5px;
            ChatAction {
                label: I18n.t("chatUi.addNote");
                tip: I18n.t("chatUi.addNoteTip");
                primary: true;
                enabled: root.can-edit && Agent.note-draft != "";
                clicked => { root.add(); }
            }
            ChatAction {
                label: I18n.t("chatUi.sendNotes");
                tip: I18n.t("chatUi.sendNotesTip");
                min-width: 0px;
                horizontal-stretch: 1;
                elide-label: true;
                enabled: root.can-edit && Agent.notes-can-send;
                clicked => { Agent.send-notes(); }
            }
        }
    }
}

component ChatPauseReview inherits Rectangle {
    property <bool> can-edit: Agent.enabled && !Agent.maintenance && !Agent.busy
        && !Agent.chat-opening && Agent.dictation-phase == 0;
    min-width: 0px;
    min-height: contents.preferred-height;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.field;

    contents := VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: I18n.t("chatUi.reviewPauses");
                color: Theme.fg;
                font-size: Theme.fs;
                font-weight: Theme.weight-title;
                vertical-alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;
                overflow: elide;
            }
            Text {
                text: Agent.pause-selected-count + " of " + Agent.pause-cuts.length + " selected";
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }
        }
        rows := Flickable {
            min-width: 0px;
            min-height: 0px;
            max-height: 92px;
            preferred-height: Math.min(self.max-height, cuts.preferred-height);
            vertical-stretch: 0;
            content-width: self.width;
            content-height: Math.max(self.height, cuts.preferred-height);
            cuts := VerticalLayout {
                spacing: 4px;
                width: Math.max(0px, rows.width - 8px);
                for cut in Agent.pause-cuts: HorizontalLayout {
                    spacing: 4px;
                    ChatAction {
                        label: (cut.included ? I18n.t1("chatUi.excludeCut", cut.label) : I18n.t1("chatUi.includeCut", cut.label));
                        glyph: cut.included ? Glyph.check : Glyph.none;
                        square: true;
                        ghost: false;
                        enabled: root.can-edit && Agent.pause-audition < 0;
                        clicked => { Agent.set-pause-included(cut.id, !cut.included); }
                    }
                    ChatAction {
                        label: I18n.t1("chatUi.goCut", cut.label);
                        min-width: 0px;
                        horizontal-stretch: 1;
                        elide-label: true;
                        enabled: root.can-edit && Agent.pause-audition < 0;
                        clicked => { Agent.jump-to-pause(cut.id); }
                    }
                    ChatAction {
                        property <bool> playing: Agent.pause-audition == cut.id;
                        label: self.playing ? I18n.t("chatUi.stopListening") : I18n.t1("chatUi.listenCut", cut.label);
                        glyph: self.playing ? Glyph.stop : Glyph.play;
                        square: true;
                        enabled: root.can-edit;
                        clicked => { Agent.audition-pause(cut.id); }
                    }
                }
            }
            ThinScrollbar {
                x: parent.width - self.width;
                y: -rows.content-y;
                height: rows.height;
                viewport: rows.height;
                content: rows.content-height;
                offset: -rows.content-y;
                scrolled(to) => { rows.content-y = -to; }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 4px;
            ChatAction {
                label: I18n.t("chatUi.discardCuts");
                tip: I18n.t("chatUi.discardCutsTip");
                enabled: root.can-edit;
                clicked => { Agent.discard-pause-cuts(); }
            }
            ChatAction {
                label: I18n.t("chatUi.applyCuts");
                tip: I18n.t("chatUi.applyCutsTip");
                primary: true;
                ghost: false;
                enabled: root.can-edit && Agent.pause-can-apply && Agent.pause-selected-count > 0;
                clicked => { Agent.apply-pause-cuts(); }
            }
        }
    }
}

component ChatQuickActions inherits VerticalLayout {
    property <bool> can-edit: Agent.enabled && !Agent.maintenance && !Agent.busy && !Agent.chat-opening;
    property <bool> can-run: root.can-edit && Agent.quick-ready;
    // The three built-ins precede the saved actions in the shared model.
    property <int> built-in-count: 3;
    min-width: 0px;
    spacing: 4px;

    if Agent.has-project && Agent.quick-actions.length >= root.built-in-count: HorizontalLayout {
        spacing: 4px;
        for position in root.built-in-count: ChatAction {
            property <AgentQuickActionData> action: Agent.quick-actions[position];
            label: self.action.label;
            tip: self.action.id == "captions" ? I18n.t("chatUi.tipCaptions")
                : self.action.id == "trim-pauses" ? I18n.t("chatUi.tipTrimPauses")
                : I18n.t("chatUi.tipVertical");
            ghost: false;
            min-width: 0px;
            horizontal-stretch: 1;
            elide-label: true;
            enabled: root.can-run;
            clicked => { Agent.run-quick-action(self.action.id); }
        }
    }

    if Agent.has-project && Agent.cutaway-ready: ChatAction {
        label: I18n.t("agent.cutaways");
        tip: I18n.t("agent.cutawaysTip");
        enabled: root.can-edit;
        min-width: 0px;
        elide-label: true;
        ghost: false;
        clicked => { Agent.suggest-cutaways(); }
    }

    if Agent.quick-actions.length > root.built-in-count: pins := Flickable {
        min-width: 0px;
        min-height: 0px;
        max-height: 62px;
        preferred-height: Math.min(62px, list.preferred-height);
        vertical-stretch: 0;
        content-width: self.width;
        content-height: Math.max(self.height, list.preferred-height);

        list := VerticalLayout {
            width: Math.max(0px, pins.width - 8px);
            spacing: 4px;
            for position in Agent.quick-actions.length - root.built-in-count: HorizontalLayout {
                property <AgentQuickActionData> action: Agent.quick-actions[position + root.built-in-count];
                spacing: 4px;
                ChatAction {
                    label: parent.action.label;
                    tip: I18n.t("chatUi.pinnedTip");
                    ghost: false;
                    min-width: 0px;
                    horizontal-stretch: 1;
                    elide-label: true;
                    enabled: root.can-run;
                    clicked => { Agent.run-quick-action(parent.action.id); }
                }
                ChatAction {
                    label: I18n.t1("chatUi.unpin", parent.action.label);
                    tip: I18n.t("chatUi.unpinTip");
                    glyph: Glyph.close;
                    square: true;
                    enabled: root.can-edit;
                    clicked => { Agent.unpin-quick-action(parent.action.id); }
                }
            }
        }
        ThinScrollbar {
            x: parent.width - self.width;
            y: -pins.content-y;
            height: pins.height;
            viewport: pins.height;
            content: pins.content-height;
            offset: -pins.content-y;
            scrolled(to) => { pins.content-y = -to; }
        }
    }

    if Agent.has-project && !Agent.quick-ready: Text {
        text: I18n.t("chatUi.selectTimelineTarget");
        min-width: 0px;
        color: Theme.fg-muted;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }
    if Agent.draft != "": HorizontalLayout {
        alignment: end;
        spacing: 4px;
        ChatAction {
            label: I18n.t("chatUi.pinDraft");
            tip: I18n.t("chatUi.pinDraftTip");
            enabled: root.can-edit;
            clicked => { Agent.pin-quick-action(); }
        }
        ChatAction {
            label: I18n.t("chatUi.pinTemplate");
            tip: I18n.t("chatUi.pinTemplateTip");
            enabled: root.can-edit;
            clicked => { Agent.pin-template(); }
        }
    }
}

component PinnedCommandParameters inherits VerticalLayout {
    min-width: 0px;
    min-height: 0px;
    vertical-stretch: 1;
    padding: 10px;
    spacing: 7px;

    Text {
        text: Agent.parameter-title;
        color: Theme.fg;
        font-size: Theme.fs-lg;
        wrap: word-wrap;
    }
    Text {
        text: Agent.parameter-scope;
        color: Theme.fg-muted;
        font-size: Theme.fs;
        overflow: elide;
    }
    if Agent.parameter-error != "": AgentTextViewport {
        value: Agent.parameter-error;
        ink: Theme.danger;
    }

    viewport := Flickable {
        min-height: 0px;
        vertical-stretch: 1;
        content-width: self.width;
        content-height: Math.max(self.height, fields.preferred-height);

        fields := VerticalLayout {
            width: Math.max(0px, viewport.width - 8px);
            alignment: start;
            spacing: 7px;
            for field[index] in Agent.parameter-fields: VerticalLayout {
                spacing: 3px;
                Text {
                    text: field.name;
                    color: Theme.fg-muted;
                    font-size: Theme.fs;
                    wrap: word-wrap;
                }
                NoteInput {
                    value: field.value;
                    label: field.name;
                    enabled: !Agent.maintenance && !Agent.busy;
                    edited(text) => { Agent.parameter-edited(index, text); }
                    submitted => {
                        if (Agent.parameter-can-send) { Agent.submit-parameters(); }
                    }
                }
            }
        }
        ThinScrollbar {
            x: parent.width - self.width;
            y: -viewport.content-y;
            height: viewport.height;
            viewport: viewport.height;
            content: viewport.content-height;
            offset: -viewport.content-y;
            scrolled(to) => { viewport.content-y = -to; }
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 5px;
        ChatAction {
            label: I18n.t("chatUi.cancel");
            accessible-name: I18n.t("chatUi.cancelParameters");
            clicked => { Agent.cancel-parameters(); }
        }
        ChatAction {
            label: I18n.t("chatUi.runCommand");
            tip: I18n.t("chatUi.runCommandTip");
            primary: true;
            enabled: Agent.parameter-can-send;
            clicked => { Agent.submit-parameters(); }
        }
    }
}

component EditScopeCheck inherits Rectangle {
    in property <string> label;
    in property <string> tip;
    in property <bool> checked;
    in property <bool> enabled;
    out property <bool> focused: keys.has-focus;
    callback toggled(checked: bool);

    min-width: 0px;
    min-height: Math.max(28px, row.preferred-height);
    vertical-stretch: 0;
    border-radius: Theme.r;
    background: touch.has-hover && root.enabled ? Theme.field-hover : Theme.field;
    border-width: root.focused ? 1px : 0px;
    border-color: Theme.accent;
    opacity: root.enabled ? 1.0 : 0.45;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-description: root.tip;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        if (root.enabled) { root.toggled(!root.checked); }
    }
    forward-focus: keys;

    row := HorizontalLayout {
        padding: 5px;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;

            Check {
                checked: root.checked;
                enabled: false;
                opacity: 1;
            }
        }
        Text {
            text: root.label;
            min-width: 0px;
            wrap: word-wrap;
            vertical-alignment: center;
            color: Theme.fg;
            font-size: Theme.fs;
        }
    }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.toggled(!root.checked);
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            keys.focus();
            root.toggled(!root.checked);
        }
    }
    if root.tip != "": Tip {
        text: root.tip;
        active: touch.has-hover;
    }
}

component ChatEditScope inherits VerticalLayout {
    property <bool> editable: Agent.enabled && !Agent.maintenance && !Agent.busy
        && !Agent.chat-opening && Agent.dictation-phase == 0;

    min-width: 0px;
    min-height: 0px;
    vertical-stretch: 1;
    padding: 10px;
    spacing: 6px;

    function reveal(y: length, h: length) {
        if (y + viewport.content-y < 0px || h > viewport.height) {
            viewport.content-y = Math.max(-y, viewport.height - viewport.content-height);
        } else if (y + h + viewport.content-y > viewport.height) {
            viewport.content-y = viewport.height - y - h;
        }
    }

    if Agent.edit-scope-error != "": AgentTextViewport {
        value: Agent.edit-scope-error;
        ink: Theme.danger;
    }

    viewport := Flickable {
        min-height: 0px;
        vertical-stretch: 1;
        content-width: self.width;
        content-height: Math.max(self.height, fields.preferred-height);

        fields := VerticalLayout {
            width: Math.max(0px, viewport.width - 8px);
            alignment: start;
            spacing: 6px;

            if Agent.edit-scope-active && Agent.edit-scope-summary != "": Text {
                text: Agent.edit-scope-summary;
                color: Theme.accent;
                font-size: Theme.fs;
                wrap: word-wrap;
            }

            Text {
                text: I18n.t("agent.scopeTracks");
                color: Theme.fg-muted;
                font-size: Theme.fs;
                font-weight: Theme.weight-title;
                wrap: word-wrap;
            }
            for track in Agent.edit-scope-tracks: EditScopeCheck {
                label: track.label;
                checked: track.selected;
                enabled: root.editable;
                changed focused => { if self.focused { root.reveal(self.y, self.height); } }
                toggled(included) => { Agent.edit-scope-track(track.id, included); }
            }

            Rectangle {
                height: 1px;
                background: Theme.line;
            }

            EditScopeCheck {
                label: I18n.t("agent.scopeLimitRange");
                tip: I18n.t("agent.scopeNeedRange");
                checked: Agent.edit-scope-limit-range;
                enabled: root.editable;
                changed focused => { if self.focused { root.reveal(self.y, self.height); } }
                toggled(enabled) => { Agent.toggle-edit-scope-range(enabled); }
            }
            if Agent.edit-scope-limit-range: Text {
                text: Agent.edit-scope-range-label != ""
                    ? Agent.edit-scope-range-label : I18n.t("agent.scopeNeedRange");
                color: Agent.edit-scope-range-ready ? Theme.fg : Theme.fg-muted;
                font-size: Theme.fs;
                wrap: word-wrap;
            }
            if Agent.edit-scope-limit-range: HorizontalLayout {
                spacing: 5px;
                ChatAction {
                    label: I18n.t("agent.scopeSetIn");
                    enabled: root.editable;
                    clicked => { Agent.mark-range(true); }
                }
                ChatAction {
                    label: I18n.t("agent.scopeSetOut");
                    enabled: root.editable && Agent.has-range;
                    clicked => { Agent.mark-range(false); }
                }
            }
        }

        ThinScrollbar {
            x: parent.width - self.width;
            y: -viewport.content-y;
            height: viewport.height;
            viewport: viewport.height;
            content: viewport.content-height;
            offset: -viewport.content-y;
            scrolled(to) => { viewport.content-y = -to; }
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: 6px;
        if Agent.edit-scope-active: ChatAction {
            label: I18n.t("agent.scopeClear");
            enabled: root.editable;
            clicked => { Agent.clear-edit-scope(); Focus.release(); }
        }
        ChatAction {
            label: I18n.t("common.apply");
            primary: true;
            enabled: root.editable && Agent.edit-scope-can-save;
            clicked => { Agent.save-edit-scope(); Focus.release(); }
        }
    }
}

component SavedChatRow inherits Rectangle {
    in property <AgentSavedChatData> chat;
    in property <bool> enabled;
    min-height: content.preferred-height;
    border-radius: Theme.r;
    border-width: keys.has-focus || root.chat.active ? 1px : 0px;
    border-color: Theme.accent;
    background: root.chat.active ? Theme.accent-soft
        : touch.has-hover && root.enabled ? Theme.field-hover : Theme.field;
    accessible-role: button;
    accessible-label: root.chat.title + (root.chat.active ? " · Current chat" : "");
    accessible-action-default => {
        if root.enabled { Agent.open-chat(root.chat.id); }
    }
    content := VerticalLayout {
        padding: 9px;
        spacing: 3px;
        Text {
            min-width: 0px;
            text: root.chat.title;
            overflow: elide;
            color: Theme.fg;
            font-size: Theme.fs-lg;
        }
        if root.chat.workspace != "" || root.chat.has-draft: HorizontalLayout {
            spacing: 6px;
            Text {
                min-width: 0px;
                text: root.chat.workspace;
                overflow: elide;
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
                horizontal-stretch: 1;
            }
            if root.chat.has-draft: Text {
                text: I18n.t("chatUi.draft");
                color: Theme.accent;
                font-size: Theme.fs-sm;
            }
        }
    }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                Agent.open-chat(root.chat.id);
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { Agent.open-chat(root.chat.id); }
    }
}

component ChatHistoryView inherits VerticalLayout {
    min-width: 0px;
    min-height: 0px;
    preferred-height: 0px;
    vertical-stretch: 1;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 10px;
    spacing: 8px;

    Field {
        value: Agent.chat-query;
        placeholder: I18n.t("chatUi.searchChats");
        edited(query) => {
            Agent.chat-query = query;
            Agent.chat-filter-edited(query);
        }
    }
    if Agent.history-error != "" || Agent.error != "": AgentTextViewport {
        value: Agent.history-error != "" ? Agent.history-error : Agent.error;
        ink: Theme.danger;
    }
    if Agent.history-loading || Agent.chat-opening || (Agent.saved-chats.length == 0 && Agent.history-error == ""): Text {
        text: Agent.chat-opening ? I18n.t("chatUi.openingChat")
            : Agent.history-loading ? I18n.t("chatUi.loadingChats")
            : Agent.chat-query != "" ? I18n.t("chatUi.noMatchingChats") : I18n.t("chatUi.noSavedChats");
        font-size: Theme.fs;
        color: Theme.fg-muted;
        wrap: word-wrap;
    }
    list-viewport := Flickable {
        min-width: 0px;
        min-height: 0px;
        preferred-height: 0px;
        vertical-stretch: 1;
        content-width: self.width;
        content-height: Math.max(self.height, list.preferred-height);
        list := VerticalLayout {
            width: list-viewport.width - 7px;
            spacing: 6px;
            alignment: start;
            for chat in Agent.saved-chats: SavedChatRow {
                chat: chat;
                enabled: Agent.enabled && !Agent.maintenance && !Agent.busy &&
                    (Agent.connected || chat.active);
            }
        }
        ThinScrollbar {
            x: parent.width - self.width;
            y: -list-viewport.content-y;
            height: list-viewport.height;
            viewport: list-viewport.height;
            content: list-viewport.content-height;
            offset: -list-viewport.content-y;
            scrolled(to) => { list-viewport.content-y = -to; }
        }
    }
}

component ChatQueueRow inherits Rectangle {
    in property <AgentQueueItem> task;
    in property <bool> editable;
    callback action-focused(y: length, height: length);

    min-width: 0px;
    min-height: body.preferred-height;
    vertical-stretch: 0;
    border-radius: Theme.r;
    background: Theme.field;
    accessible-role: list-item;

    function reveal-actions() {
        root.action-focused(actions.absolute-position.y - root.absolute-position.y, actions.height);
    }

    body := VerticalLayout {
        padding: 8px;
        spacing: 4px;
        Text {
            text: root.task.status;
            min-width: 0px;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
        Text {
            text: root.task.prompt;
            min-width: 0px;
            max-height: 58px;
            overflow: elide;
            color: Theme.fg;
            font-size: Theme.fs-lg;
            wrap: word-wrap;
        }
        if root.task.detail != "": Text {
            text: root.task.detail;
            min-width: 0px;
            max-height: 48px;
            overflow: elide;
            color: Theme.fg-muted;
            font-size: Theme.fs;
            wrap: word-wrap;
        }
        actions := HorizontalLayout {
            alignment: stretch;
            spacing: 4px;
            if root.task.pending: Rectangle {
                width: 28px;
                height: 28px;
                border-radius: Theme.r;
                background: handle.has-hover || drag.dragging ? Theme.field-hover : Colors.transparent;

                accessible-role: text;
                accessible-label: I18n.t("agent.queueDragHint");

                drag := DragArea {
                    width: parent.width;
                    height: parent.height;
                    enabled: root.editable;
                    data: Payload.of(root.task.drag-token);
                    allow-copy: false;
                    allow-move: true;

                    handle := TouchArea {
                        enabled: root.editable;
                        mouse-cursor: MouseCursor.grab;
                    }
                    for dot[index] in 6: Rectangle {
                        x: 10px + Math.mod(index, 2) * 6px;
                        y: 7px + Math.floor(index / 2) * 5px;
                        width: 3px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: handle.has-hover ? Theme.fg : Theme.fg-muted;
                    }
                }
                Tip {
                    text: I18n.t("agent.queueDragHint");
                    active: handle.has-hover && !drag.dragging;
                }
            }
            if root.task.pending: Rectangle { horizontal-stretch: 1; }
            if root.task.pending: ChatAction {
                label: I18n.t("agent.queueMoveUp");
                tip: I18n.t("agent.queueMoveUpHint");
                glyph: Glyph.chevron-up;
                square: true;
                max-width: 28px;
                horizontal-stretch: 0;
                enabled: root.editable && root.task.can-move-up;
                clicked => { Agent.queue-move(root.task.id, -1); }
                changed focused => { if self.focused { root.reveal-actions(); } }
            }
            if root.task.pending: ChatAction {
                label: I18n.t("agent.queueMoveDown");
                tip: I18n.t("agent.queueMoveDownHint");
                glyph: Glyph.chevron-down;
                square: true;
                max-width: 28px;
                horizontal-stretch: 0;
                enabled: root.editable && root.task.can-move-down;
                clicked => { Agent.queue-move(root.task.id, 1); }
                changed focused => { if self.focused { root.reveal-actions(); } }
            }
            if root.task.pending: ChatAction {
                label: I18n.t("agent.queueCancel");
                tip: I18n.t("agent.queueCancelHint");
                glyph: Glyph.close;
                square: true;
                max-width: 28px;
                horizontal-stretch: 0;
                enabled: root.editable;
                clicked => { Agent.queue-cancel(root.task.id); }
                changed focused => { if self.focused { root.reveal-actions(); } }
            }
            if root.task.cancelled: ChatAction {
                label: I18n.t("agent.queueReturn");
                tip: I18n.t("agent.queueReturnHint");
                min-width: 0px;
                elide-label: true;
                ghost: false;
                horizontal-stretch: 1;
                enabled: root.editable;
                clicked => { Tips.close(); Agent.queue-restore-cancelled(root.task.id); }
                changed focused => { if self.focused { root.reveal-actions(); } }
            }
            if root.task.recoverable: ChatAction {
                label: I18n.t("agent.queueRestore");
                tip: I18n.t("agent.queueRestoreHint");
                glyph: root.task.cancelled ? Glyph.copy : Glyph.none;
                square: root.task.cancelled;
                min-width: root.task.cancelled ? 28px : 0px;
                elide-label: !root.task.cancelled;
                horizontal-stretch: root.task.cancelled ? 0 : 1;
                enabled: root.editable;
                clicked => { Tips.close(); Agent.queue-restore(root.task.id); }
                changed focused => { if self.focused { root.reveal-actions(); } }
            }
        }
    }

    landing := DropArea {
        width: root.width;
        height: root.height;
        enabled: root.editable && root.task.pending;
        property <bool> after;

        can-drop(event) => {
            self.after = event.position.y >= self.height / 2;
            return Agent.queue-can-drop(Payload.text(event.data), root.task.id)
                ? DragAction.move : DragAction.none;
        }

        dropped(event) => {
            return Agent.queue-drop(Payload.text(event.data), root.task.id, event.position.y >= self.height / 2)
                ? DragAction.move : DragAction.none;
        }
    }

    if landing.has-drag: Rectangle {
        x: 4px;
        y: landing.after ? parent.height - 2px : 0px;
        width: parent.width - 8px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
    }
}

component ChatQueueView inherits VerticalLayout {
    property <bool> editable: Agent.enabled && !Agent.maintenance && !Agent.chat-opening;

    min-width: 0px;
    min-height: 0px;
    preferred-height: 0px;
    vertical-stretch: 1;
    padding: 10px;
    spacing: 7px;

    function reveal(y: length, h: length) {
        if (y + viewport.content-y < 0px || h > viewport.height) {
            viewport.content-y = Math.max(-y, viewport.height - viewport.content-height);
        } else if (y + h + viewport.content-y > viewport.height) {
            viewport.content-y = viewport.height - y - h;
        }
    }

    if Agent.queue-error != "": AgentTextViewport {
        value: Agent.queue-error;
        ink: Theme.danger;
    }

    viewport := Flickable {
        min-width: 0px;
        min-height: 0px;
        vertical-stretch: 1;
        interactive: false;
        content-width: self.width;
        content-height: Math.max(self.height, items.preferred-height);
        accessible-role: list;
        accessible-label: I18n.t("agent.queueTitle");

        items := VerticalLayout {
            width: Math.max(0px, viewport.width - 8px);
            alignment: start;
            spacing: 6px;
            if Agent.queue-items.length == 0: Text {
                text: I18n.t("agent.queueEmpty");
                color: Theme.fg-muted;
                font-size: Theme.fs;
                wrap: word-wrap;
            }
            for item in Agent.queue-items: ChatQueueRow {
                task: item;
                editable: root.editable;
                action-focused(y, height) => { root.reveal(self.y + y, height); }
            }
        }
        ThinScrollbar {
            x: parent.width - self.width;
            y: -viewport.content-y;
            height: viewport.height;
            viewport: viewport.height;
            content: viewport.content-height;
            offset: -viewport.content-y;
            scrolled(to) => { viewport.content-y = -to; }
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: 6px;
        ChatAction {
            label: Agent.queue-paused ? I18n.t("agent.queueResume") : I18n.t("agent.queuePause");
            tip: Agent.queue-paused ? I18n.t("agent.queueResumeHint") : I18n.t("agent.queuePauseHint");
            min-width: 0px;
            horizontal-stretch: 1;
            elide-label: true;
            enabled: root.editable && (!Agent.queue-paused || Agent.queue-can-run);
            ghost: false;
            clicked => { Tips.close(); Agent.queue-set-paused(!Agent.queue-paused); }
        }
        if Agent.busy && !Agent.chat-opening: ChatAction {
            label: I18n.t("agent.queueInterrupt");
            tip: I18n.t("agent.queueInterruptHint");
            glyph: Glyph.stop;
            square: true;
            enabled: root.editable;
            clicked => { Agent.interrupt(); }
        }
    }
}

component ChatSendActions inherits HorizontalLayout {
    in property <bool> show-queue-action;

    alignment: end;
    spacing: 6px;
    if root.show-queue-action && Agent.busy && !Agent.chat-opening: ChatAction {
        label: I18n.t("agent.queueInterrupt");
        tip: I18n.t("agent.queueInterruptHint");
        glyph: Glyph.stop;
        square: true;
        enabled: !Agent.maintenance;
        clicked => { Agent.interrupt(); }
    }
    if root.show-queue-action: ChatAction {
        label: I18n.t("agent.queueEnqueue");
        tip: I18n.t("agent.queueEnqueueHint");
        min-width: 0px;
        preferred-width: 116px;
        elide-label: true;
        ghost: false;
        enabled: Agent.queue-can-enqueue;
        clicked => { Tips.close(); Agent.enqueue-draft(); }
    }
    Button {
        label: I18n.t("chatUi.send");
        tip: I18n.t("chatUi.sendTip");
        primary: true;
        enabled: Agent.enabled && !Agent.maintenance && !Agent.busy && Agent.dictation-phase == 0 && Agent.draft != "";
        clicked => { Agent.submitted(); }
    }
}

component ChatConversation inherits Rectangle {
    min-width: 0px;
    min-height: 0px;
    preferred-height: 0px;
    vertical-stretch: 1;
    clip: true;
    property <int> voice-phase: Agent.dictation-phase;
    property <bool> had-dictation;
    property <bool> show-queue-action: Agent.enabled && Agent.dictation-phase == 0 && Agent.draft != "";
    property <length> composer-left: composer-frame.absolute-position.x;
    property <length> composer-top: composer-frame.absolute-position.y;
    property <length> composer-width: composer-frame.width;
    property <length> composer-height: composer-frame.height;
    changed composer-left => { Agent.drop-left = root.composer-left; }
    changed composer-top => { Agent.drop-top = root.composer-top; }
    changed composer-width => { Agent.drop-width = root.composer-width; }
    changed composer-height => { Agent.drop-height = root.composer-height; }
    init => {
        Agent.drop-left = root.composer-left;
        Agent.drop-top = root.composer-top;
        Agent.drop-width = root.composer-width;
        Agent.drop-height = root.composer-height;
    }
    changed voice-phase => {
        if (root.voice-phase != 0) {
            root.had-dictation = true;
        } else if (root.had-dictation) {
            root.had-dictation = false;
            input.focus();
            input.set-selection-offsets(1000000000, 1000000000);
        }
    }

    VerticalLayout {
        if Agent.has-project && Agent.chat-title != "": HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            Text {
                min-width: 0px;
                text: I18n.t1("chatUi.projectLabel", Agent.project-name);
                overflow: elide;
                font-size: Theme.fs;
                color: Theme.fg-muted;
            }
        }

        if !Agent.has-project: HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-bottom: 6px;
            spacing: 6px;
            Text {
                text: Agent.workspace-path == "" ? I18n.t("chatUi.workingFolderNeeded") : Agent.workspace-path;
                color: Theme.fg-muted;
                font-size: Theme.fs;
                min-width: 0px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
            Button {
                label: I18n.t("chatUi.chooseFolder");
                tip: I18n.t("chatUi.chooseFolderTip");
                ghost: true;
                enabled: Agent.enabled && !Agent.maintenance && !Agent.busy && Agent.dictation-phase == 0;
                clicked => { Agent.choose-workspace(); }
            }
        }

        transcript := Flickable {
            min-width: 0px;
            min-height: 0px;
            preferred-height: 0px;
            vertical-stretch: 1;
            interactive: false;
            content-width: self.width;
            content-height: Math.max(self.height, history.preferred-height);
            property <length> previous-height;
            property <bool> showing-review;
            changed content-height => {
                if (-self.content-y + self.height >= self.previous-height - 24px
                    || (!self.showing-review && Agent.pause-cuts.length > 0)) {
                    self.content-y = Math.min(0px, self.height - self.content-height);
                }
                self.previous-height = self.content-height;
                self.showing-review = Agent.pause-cuts.length > 0;
            }
            history := VerticalLayout {
                width: transcript.width;
                padding: 12px;
                spacing: 12px;
                alignment: start;
                if Agent.has-earlier: ChatAction {
                    label: Agent.earlier-loading ? I18n.t("chatUi.loadingEarlier") : I18n.t("chatUi.earlierMessages");
                    tip: I18n.t("chatUi.earlierMessagesTip");
                    ghost: true;
                    enabled: Agent.connected && !Agent.maintenance && !Agent.busy
                        && !Agent.earlier-loading && Agent.dictation-phase == 0;
                    clicked => { Agent.load-earlier(); }
                }
                if Agent.messages.length == 0: Text {
                    text: Agent.has-project
                        ? I18n.t("chatUi.editIntro")
                        : I18n.t("chatUi.landingIntro");
                    color: Theme.fg-muted;
                    font-size: Theme.fs-lg;
                    wrap: word-wrap;
                }
                for message in Agent.messages: Rectangle {
                    min-height: message-body.preferred-height;
                    background: message.role == "You" ? Theme.field : Colors.transparent;
                    border-radius: Theme.r;
                    message-body := VerticalLayout {
                        padding: 8px;
                        spacing: 5px;
                        Text {
                            text: message.role + (message.streaming ? " · …" : "");
                            color: message.failed ? Theme.danger : message.role == "You" ? Theme.accent : Theme.fg-muted;
                            font-size: Theme.fs-sm;
                            font-weight: Theme.weight-title;
                        }
                        AgentWords {
                            text: message.text;
                            color: message.failed ? Theme.danger : Theme.fg;
                        }
                        if message.context != "": Text {
                            text: message.context;
                            min-width: 0px;
                            wrap: word-wrap;
                            color: Theme.fg-muted;
                            font-size: Theme.fs-sm;
                        }
                        for link[index] in message.edit-links: ChatAction {
                            min-width: 0px;
                            label: link;
                            enabled: Agent.has-project && !Agent.maintenance;
                            clicked => { Agent.jump-to-edit(message.id, index); }
                        }
                        if message.has-checkpoint: ChatAction {
                            property <bool> restore-in-place: Agent.undoable-message == message.id;
                            label: self.restore-in-place ? I18n.t("chatUi.undoTurn") : I18n.t("chatUi.openBeforeCopy");
                            enabled: !Agent.busy && !Agent.maintenance && Agent.dictation-phase == 0;
                            clicked => { Agent.restore-turn(message.id, !self.restore-in-place); }
                        }
                    }
                }
                if Agent.has-project && Agent.pause-cuts.length > 0: ChatPauseReview { }
            }
            ThinScrollbar {
                x: parent.width - self.width - 1px;
                y: -transcript.content-y;
                height: transcript.height;
                viewport: transcript.height;
                content: transcript.content-height;
                offset: -transcript.content-y;
                scrolled(to) => { transcript.content-y = -to; }
            }
        }

        if Agent.approvals.length > 0: approvals := Flickable {
            min-height: 0px;
            preferred-height: Math.min(140px, requests.preferred-height);
            max-height: 260px;
            vertical-stretch: 0;
            interactive: false;
            content-height: requests.preferred-height;
            content-width: self.width;
            requests := VerticalLayout {
                width: parent.width;
                padding: 12px;
                spacing: 8px;
                for request in Agent.approvals: Rectangle {
                    min-height: request-body.preferred-height;
                    background: Theme.accent-soft;
                    border-radius: Theme.r;
                    request-body := VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        Text {
                            text: request.title;
                            color: Theme.fg;
                            font-size: Theme.fs-lg;
                            font-weight: Theme.weight-title;
                            wrap: word-wrap;
                        }
                        AgentWords { text: request.detail; }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            Button {
                                label: I18n.t("chatUi.deny");
                                tip: I18n.t("chatUi.denyTip");
                                clicked => { Agent.approval(request.id, false); }
                            }
                            Button {
                                label: I18n.t("chatUi.allowOnce");
                                tip: I18n.t("chatUi.allowOnceTip");
                                primary: true;
                                clicked => { Agent.approval(request.id, true); }
                            }
                        }
                    }
                }
            }
            ThinScrollbar {
                x: parent.width - self.width - 1px;
                y: -approvals.content-y;
                height: approvals.height;
                viewport: approvals.height;
                content: approvals.content-height;
                offset: -approvals.content-y;
                scrolled(to) => { approvals.content-y = -to; }
            }
        }

        VerticalLayout {
            padding: Agent.dictation-phase != 0 ? 8px : 12px;
            spacing: Agent.dictation-phase != 0 ? 6px : 8px;
            if Agent.error != "": chat-error-view := AgentTextViewport {
                value: Agent.error;
                ink: Theme.danger;
            }
            if Agent.dictation-phase == 0: HorizontalLayout {
                spacing: 6px;
                Text {
                    text: !Agent.enabled ? I18n.t("chatUi.liveRequired") : Agent.maintenance ? I18n.t("chatUi.installingUpdate") : Agent.status;
                    min-width: 0px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    color: Theme.fg-muted;
                    font-size: Theme.fs;
                    wrap: word-wrap;
                }
                if Agent.enabled: ChatAction {
                    label: Agent.queue-count > 0
                        ? I18n.t1("agent.queueOpenCount", Agent.queue-count) : I18n.t("agent.queueOpen");
                    tip: I18n.t("agent.queueOpenHint");
                    enabled: !Agent.maintenance && !Agent.chat-opening;
                    clicked => { Tips.close(); Agent.toggle-queue(); Focus.release(); }
                }
            }
            if Agent.dictation-phase != 0: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            glyph: Glyph.mic;
                            size: 14px;
                            tint: Agent.dictation-phase == 2 ? Theme.danger : Theme.fg-muted;
                        }
                    }
                    Text {
                        text: Agent.dictation-status != "" ? Agent.dictation-status
                            : Agent.dictation-phase == 1 ? I18n.t("chatUi.dictationPreparing")
                            : Agent.dictation-phase == 2 ? I18n.t("chatUi.dictationListening") : I18n.t("chatUi.dictationFinishing");
                        min-width: 0px;
                        horizontal-stretch: 1;
                        color: Agent.dictation-phase == 2 ? Theme.fg : Theme.fg-muted;
                        font-size: Theme.fs;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                    Text {
                        text: Agent.dictation-seconds + " s";
                        color: Theme.fg-muted;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                    }
                }
                if Agent.dictation-phase == 2: LevelMeter {
                    value: Agent.dictation-level;
                    min-height: 6px;
                    max-height: 6px;
                    preferred-height: 6px;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    if Agent.dictation-phase == 2: dictation-stop-button := Button {
                        label: I18n.t("chatUi.stopDictation");
                        tip: I18n.t("chatUi.stopDictationTip");
                        clicked => { Agent.dictation-stop(); }
                    }
                    dictation-cancel-button := Button {
                        label: I18n.t("chatUi.cancel");
                        ghost: true;
                        clicked => { Agent.dictation-cancel(); }
                    }
                }
            }
            if Agent.dictation-preview != "" && (Agent.dictation-phase != 0 || Agent.dictation-error != ""): dictation-preview-view := AgentTextViewport {
                min-height: 16px;
                value: Agent.dictation-preview;
                follow-end: true;
            }
            if Agent.dictation-error != "": dictation-error-view := AgentTextViewport {
                value: Agent.dictation-error;
                ink: Theme.danger;
            }
            if Agent.dictation-phase == 0: HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    spacing: 3px;
                    horizontal-stretch: 2;
                    Text {
                        text: I18n.t("chatUi.model");
                        color: Theme.fg-muted;
                        font-size: Theme.fs-sm;
                    }
                    model-picker := Select {
                        options: Agent.model-options;
                        tip: I18n.t("chatUi.modelTip");
                        current <=> Agent.model-index;
                        placeholder: Agent.model-placeholder;
                        enabled: Agent.enabled && !Agent.maintenance && !Agent.busy
                            && Agent.model-options.length > 0;
                        changed(index) => { Agent.model-selected(index); }
                    }
                }
                VerticalLayout {
                    spacing: 3px;
                    horizontal-stretch: 1;
                    Text {
                        text: I18n.t("chatUi.reasoning");
                        color: Theme.fg-muted;
                        font-size: Theme.fs-sm;
                    }
                    effort-picker := Select {
                        options: Agent.effort-options;
                        tip: I18n.t("chatUi.effortTip");
                        current <=> Agent.effort-index;
                        placeholder: Agent.effort-placeholder;
                        enabled: Agent.enabled && !Agent.maintenance && !Agent.busy
                            && Agent.effort-options.length > 0;
                        changed(index) => { Agent.effort-selected(index); }
                    }
                }
            }
            if Agent.has-project && Agent.dictation-phase == 0: VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 4px;
                    ChatAction {
                        label: Agent.include-timeline ? I18n.t("chatUi.timelineOn") : I18n.t("chatUi.timelineOff");
                        tip: I18n.t("chatUi.timelineOnTip");
                        clicked => { Agent.include-timeline = !Agent.include-timeline; }
                    }
                    Text {
                        text: Agent.include-timeline ? Agent.timeline-label : "";
                        min-width: 0px;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                        color: Theme.fg-muted;
                        font-size: Theme.fs-sm;
                    }
                    ChatAction {
                        label: I18n.t("agent.scopeTitle");
                        tip: I18n.t("agent.scopeHint");
                        ghost: !Agent.edit-scope-active;
                        enabled: Agent.enabled && !Agent.maintenance && !Agent.busy && !Agent.chat-opening;
                        clicked => { Tips.close(); Agent.toggle-edit-scope(); Focus.release(); }
                    }
                }
                if Agent.edit-scope-active && Agent.edit-scope-summary != "": Text {
                    text: Agent.edit-scope-summary;
                    min-width: 0px;
                    overflow: elide;
                    color: Theme.accent;
                    font-size: Theme.fs-sm;
                }
                if Agent.include-timeline: HorizontalLayout {
                    spacing: 4px;
                    ChatAction {
                        label: I18n.t("chatUi.setIn");
                        tip: I18n.t("chatUi.setInTip");
                        clicked => { Agent.mark-range(true); }
                    }
                    ChatAction {
                        label: I18n.t("chatUi.setOut");
                        tip: I18n.t("chatUi.setOutTip");
                        enabled: Agent.has-range;
                        clicked => { Agent.mark-range(false); }
                    }
                    if Agent.has-range: ChatAction {
                        label: I18n.t("chatUi.clearRange");
                        tip: I18n.t("chatUi.clearRangeTip");
                        clicked => { Agent.clear-range(); }
                    }
                }
            }
            if Agent.enabled && Agent.dictation-phase == 0
                && (Agent.has-project || Agent.quick-actions.length > 3 || Agent.draft != ""): ChatQuickActions { }
            if Agent.attachments.length > 0 && Agent.dictation-phase == 0: attached := Flickable {
                min-width: 0px;
                min-height: 0px;
                max-height: 66px;
                preferred-height: Math.min(66px, files.preferred-height);
                vertical-stretch: 0;
                interactive: false;
                content-width: self.width;
                content-height: Math.max(self.height, files.preferred-height);
                files := VerticalLayout {
                    width: attached.width - 8px;
                    spacing: 3px;
                    for file[index] in Agent.attachments: HorizontalLayout {
                        spacing: 5px;
                        Text {
                            text: file;
                            font-size: Theme.fs;
                            color: Theme.fg;
                            min-width: 0px;
                            horizontal-stretch: 1;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        IconButton {
                            glyph: Glyph.close;
                            label: I18n.t1("chatUi.removeAttachment", file);
                            clicked => { Agent.remove-file(index); }
                        }
                    }
                }
                ThinScrollbar {
                    x: parent.width - self.width - 1px;
                    y: -attached.content-y;
                    height: attached.height;
                    viewport: attached.height;
                    content: attached.content-height;
                    offset: -attached.content-y;
                    scrolled(to) => { attached.content-y = -to; }
                }
            }
            composer-frame := Rectangle {
                min-width: 0px;
                min-height: composer.min-box;
                max-height: composer.max-box;
                vertical-stretch: 0;
                preferred-height: Math.clamp(composer.box-height, composer.min-box, composer.max-box);
                changed height => {
                    if (input.has-focus) {
                        input.set-selection-offsets(input.anchor-position-byte-offset, input.cursor-position-byte-offset);
                    }
                }
                composer := ResizeBox {
                    width: parent.width;
                    height: parent.height;
                    box-height: 86px;
                    min-box: 40px;
                    max-box: 240px;
                    content-height: input.preferred-height;
                    focused: input.has-focus || drop-zone.has-drag;
                    input := TextInput {
                        y: composer.pad-y;
                        // The viewport must follow the frame, never the text's implicit width.
                        width: Math.max(0px, composer.width - 2 * composer.pad-x);
                        height: Math.max(self.preferred-height, composer.view-height);
                        text <=> Agent.draft;
                        read-only: Agent.maintenance;
                        color: Theme.fg;
                        font-size: Theme.fs-lg;
                        single-line: false;
                        wrap: word-wrap;
                        selection-background-color: Theme.accent;
                        selection-foreground-color: Theme.on-accent;
                        edited => { Agent.draft-edited(self.text); }
                        cursor-position-changed(at) => { composer.reveal(at.y, self.font-size * 1.4); }
                        // Reflow changes the caret's visual line without moving its byte offset.
                        changed width => {
                            if (self.has-focus) {
                                self.set-selection-offsets(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                            }
                        }
                        changed height => {
                            if (self.has-focus) {
                                self.set-selection-offsets(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                            }
                        }
                        key-pressed(event) => {
                            if (event.text == Key.Return && (event.modifiers.control || event.modifiers.meta)) {
                                if (Agent.enabled && !Agent.maintenance && !Agent.busy && Agent.dictation-phase == 0 && Agent.draft != "") {
                                    Agent.submitted();
                                }
                                return accept;
                            }
                            if (event.text == Key.Home) {
                                self.set-selection-offsets(0, 0);
                                return accept;
                            }
                            if (event.text == Key.End) {
                                self.set-selection-offsets(1000000000, 1000000000);
                                return accept;
                            }
                            return reject;
                        }
                    }
                    AgentTextMenu {
                        y: input.y;
                        width: input.width;
                        height: input.height;
                        has-selection: input.anchor-position-byte-offset != input.cursor-position-byte-offset;
                        has-text: input.text != "";
                        editable: !input.read-only;
                        copy-text => { input.copy(); }
                        paste-text => { input.focus(); input.paste(); }
                        select-text => { input.focus(); input.select-all(); }
                    }
                    if Agent.draft == "" && !input.has-focus: Text {
                        y: composer.pad-y;
                        text: I18n.t("chatUi.composer");
                        color: Theme.fg-dim;
                        font-size: Theme.fs-lg;
                    }
                }
                drop-zone := DropArea {
                    width: parent.width;
                    height: parent.height;
                    enabled: Agent.enabled && !Agent.maintenance && !Agent.chat-opening && Agent.dictation-phase == 0;
                    can-drop(event) => {
                        return Agent.can-drop-payload(event.data) ? DragAction.copy : DragAction.none;
                    }
                    dropped(event) => {
                        if (!Agent.can-drop-payload(event.data)) { return DragAction.none; }
                        input.focus();
                        return Agent.drop-payload(event.data,
                            self.absolute-position.x + event.position.x,
                            self.absolute-position.y + event.position.y)
                            ? DragAction.copy : DragAction.none;
                    }
                }
            }
            if root.show-queue-action: ChatSendActions {
                show-queue-action: true;
            }
            if Agent.busy && !Agent.chat-opening && Agent.dictation-phase == 0 && !root.show-queue-action: HorizontalLayout {
                alignment: end;
                Button {
                    label: I18n.t("chatUi.interrupt");
                    tip: I18n.t("chatUi.interruptTip");
                    clicked => { Agent.interrupt(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                if Agent.dictation-available && Agent.dictation-phase == 0: dictation-language-picker := Select {
                    options: ["Русский", "English"];
                    current: Agent.dictation-language == "en-US" ? 1 : 0;
                    width: 84px;
                    enabled: Agent.enabled && !Agent.maintenance;
                    changed(index) => {
                        Agent.dictation-language = index == 1 ? "en-US" : "ru-RU";
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if Agent.busy && Agent.dictation-phase != 0: Button {
                    label: I18n.t("chatUi.interrupt");
                    tip: I18n.t("chatUi.interruptTip");
                    clicked => { Agent.interrupt(); }
                }
                if Agent.dictation-phase == 0: IconButton {
                    glyph: Glyph.plus;
                    label: I18n.t("chatUi.attach");
                    enabled: Agent.enabled && !Agent.maintenance && !Agent.chat-opening;
                    clicked => { Agent.choose-files(); }
                }
                dictation-microphone := IconButton {
                    glyph: Glyph.mic;
                    label: Agent.dictation-available
                        ? I18n.t("chatUi.dictate")
                        : I18n.t("chatUi.dictationUnavailable");
                    enabled: Agent.enabled && !Agent.maintenance && Agent.dictation-available && Agent.dictation-phase == 0;
                    clicked => { Agent.dictation-start(); input.focus(); }
                }
                if !root.show-queue-action: ChatSendActions { }
            }
        }
    }
}

export component AgentChat inherits Rectangle {
    property <bool> showing-notes: Agent.has-project && Agent.notes-open;
    property <bool> showing-brief: Agent.has-project && Agent.brief-open;
    property <bool> showing-parameters: Agent.parameter-title != "" && Agent.dictation-phase == 0;
    property <bool> showing-edit-scope: Agent.has-project && Agent.edit-scope-open
        && !root.showing-notes && !root.showing-brief && !root.showing-parameters;
    property <bool> showing-queue: Agent.queue-open && !root.showing-notes
        && !root.showing-brief && !root.showing-parameters && !root.showing-edit-scope;
    property <bool> showing-form: root.showing-notes || root.showing-brief
        || root.showing-parameters || root.showing-edit-scope || root.showing-queue;
    changed showing-form => {
        if (self.showing-form) { Agent.drop-width = 0px; }
    }

    min-width: 0px;
    min-height: 0px;
    max-height: 100000px;
    preferred-height: 0px;
    vertical-stretch: 1;
    clip: true;
    VerticalLayout {
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 6px;
            spacing: 6px;
            Text {
                text: root.showing-notes ? I18n.t("chatUi.notes")
                    : root.showing-brief ? I18n.t("chatUi.projectBrief")
                    : root.showing-parameters ? I18n.t("chatUi.commandParameters")
                    : root.showing-edit-scope ? I18n.t("agent.scopeTitle")
                    : root.showing-queue ? I18n.t("agent.queueTitle")
                    : Agent.history-open ? I18n.t("chatUi.chats")
                    : Agent.chat-title != "" ? Agent.chat-title
                    : Agent.has-project ? Agent.project-name : I18n.t("chatUi.workingFolder");
                min-width: 0px;
                color: Theme.fg-muted;
                font-size: Theme.fs;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.showing-notes: ChatAction {
                label: Agent.approvals.length > 0 ? I18n.t("chatUi.reviewApproval") : I18n.t("chatUi.backToChat");
                accessible-name: I18n.t("chatUi.backToChat");
                clicked => { Agent.toggle-notes(); }
            }
            if root.showing-brief: ChatAction {
                label: Agent.approvals.length > 0 ? I18n.t("chatUi.reviewApproval") : I18n.t("chatUi.backToChat");
                accessible-name: I18n.t("chatUi.backToChat");
                clicked => { Agent.toggle-brief(); }
            }
            if root.showing-edit-scope: ChatAction {
                label: I18n.t("agent.scopeBack");
                clicked => { Agent.toggle-edit-scope(); Focus.release(); }
            }
            if root.showing-queue: ChatAction {
                label: Agent.approvals.length > 0
                    ? I18n.t("agent.queueReviewApproval") : I18n.t("agent.scopeBack");
                tip: I18n.t("agent.queueBackHint");
                clicked => { Tips.close(); Agent.toggle-queue(); Focus.release(); }
            }
            if !root.showing-form && Agent.has-project: ChatAction {
                label: I18n.t("chatUi.brief");
                tip: I18n.t("chatUi.briefTip");
                accessible-name: I18n.t("chatUi.projectBrief");
                enabled: Agent.enabled && !Agent.maintenance && Agent.dictation-phase == 0;
                clicked => { Agent.toggle-brief(); }
            }
            if !root.showing-form: history-button := ChatAction {
                label: Agent.history-open ? I18n.t("chatUi.back") : I18n.t("chatUi.history");
                tip: I18n.t("chatUi.historyTip");
                ghost: true;
                enabled: Agent.enabled && !Agent.maintenance && !Agent.busy && Agent.dictation-phase == 0;
                clicked => { Agent.toggle-history(); }
            }
            if !root.showing-form: ChatAction {
                label: I18n.t("chatUi.newChat");
                tip: I18n.t("chatUi.newChatTip");
                ghost: true;
                enabled: Agent.enabled && !Agent.maintenance && !Agent.busy && Agent.dictation-phase == 0;
                clicked => { Agent.new-thread(); }
            }
            if !root.showing-form && !Agent.connected: IconButton {
                glyph: Glyph.rotate;
                label: I18n.t("chatUi.reconnect");
                enabled: Agent.enabled && !Agent.maintenance && !Agent.busy && Agent.dictation-phase == 0;
                clicked => { Agent.reconnect(); }
            }
        }
        if root.showing-notes: TimelineNotesView { }
        if !root.showing-notes && root.showing-brief: ProjectBriefEditor {
            goal <=> Agent.brief-goal;
            audience <=> Agent.brief-audience;
            style <=> Agent.brief-style;
            error: Agent.brief-error;
            can-save: Agent.brief-can-save;
            saved => { Agent.save-brief(); }
        }
        if !root.showing-notes && !root.showing-brief && root.showing-parameters: PinnedCommandParameters { }
        if root.showing-edit-scope: ChatEditScope { }
        if root.showing-queue: ChatQueueView { }
        if !root.showing-form && Agent.history-open: ChatHistoryView { }
        if !root.showing-form && !Agent.history-open: ChatConversation { }
    }
}

export component AgentPane inherits Pane {
    in property <int> pane-seat;
    in property <bool> pane-removable: true;
    callback pane-picked(kind: PaneKind);
    callback pane-removed();

    PaneHeader {
        title: "Codex";
        VerticalLayout {
            alignment: center;
            PaneSwitcher {
                kind: PaneKind.agent;
                seat: root.pane-seat;
                removable: root.pane-removable;
                picked(kind) => { root.pane-picked(kind); }
                removed => { root.pane-removed(); }
            }
        }
    }
    AgentChat { }
}
